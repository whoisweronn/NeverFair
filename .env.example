SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Случайная строка минимум 32 символа.
# После привязки пользователей не менять без миграции HWID.
HWID_PEPPER=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Например: my-company/neverfair-builds
GITHUB_REPO=OWNER/REPOSITORY

# Для приватного репозитория: Contents: Read.
# Для публичного токен также уменьшает риск rate limit.
GITHUB_TOKEN=YOUR_GITHUB_TOKEN

# Теги трёх GitHub Releases.
GITHUB_TAG_RELEASE=release
GITHUB_TAG_BETA=beta
GITHUB_TAG_ALPHA=alpha